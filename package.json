{
  "name": "testgungame",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "app:build": "node scripts/build-app.mjs",
    "app:pack": "node scripts/pack-app.mjs",
    "app": "host\\bin\\Release\\net10.0\\TestGunGame.exe",
    "verify:exe": "node scripts/verify-exe.mjs",
    "app:dev": "dotnet build host -c Debug --nologo -v q && host\\bin\\Debug\\net10.0\\TestGunGame.exe --dev http://localhost:25001/",
    "hwtest:build": "node scripts/build-hwtest.mjs",
    "hwtest": "hwtest\\host\\bin\\Release\\net10.0\\WiiHwTest.exe",
    "hwtest:verify": "node scripts/verify-hwtest.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
